---
import { Crown } from '@lucide/astro';
import IconLink from '../../../shared/atoms/IconLink.astro';
import type { Proyecto } from '../../../data/proyectos';

/**
 * Mini-tarjeta de un proyecto integrado, usada en la sección "Integra & encierra".
 * @property sub - Proyecto integrado a mostrar.
 */
interface Props {
	sub: Proyecto;
}
const { sub } = Astro.props;
---
<div class="rounded-xl border border-secondary/30 bg-secondary/5 p-4 backdrop-blur transition hover:border-secondary/60">
	<div class="flex items-center justify-between gap-2">
		<div class="flex items-center gap-1.5">
			<p class="text-sm font-semibold text-slate-100">{sub.nombre}</p>
			{sub.destacado && (
				<Crown class="h-3.5 w-3.5 shrink-0 text-primary" aria-label="Proyecto destacado" />
			)}
		</div>
		{sub.repoUrl && (
			<IconLink href={sub.repoUrl} label="Ver repositorio en GitHub">
				<img
					src="https://skillicons.dev/icons?i=github"
					alt="Repositorio en GitHub"
					width={18}
					height={18}
					class="h-[18px] w-[18px]"
				/>
			</IconLink>
		)}
	</div>
	<p class="mt-1 text-xs text-slate-400">{sub.descripcion}</p>
	<a
		href={`/proyectos/${sub.slug}`}
		class="mt-2 inline-block font-mono text-xs text-secondary transition hover:text-primary"
	>
		Ver proyecto &rarr;
	</a>
</div>
