---
import type { ProyectoVideo } from '../../../data/proyectos';

interface Props {
	video: ProyectoVideo;
}
const { video } = Astro.props;
---
<figure class="glass-card overflow-hidden rounded-2xl">
	<video src={video.src} controls preload="metadata" playsinline class="w-full"></video>
	{(video.titulo || video.descripcion) && (
		<figcaption class="flex flex-col gap-1 border-t border-border px-6 py-4">
			{video.titulo && (
				<span class="font-mono text-xs tracking-widest text-primary uppercase">{video.titulo}</span>
			)}
			{video.descripcion && <span class="text-sm text-slate-400">{video.descripcion}</span>}
		</figcaption>
	)}
</figure>
