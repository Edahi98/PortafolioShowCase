---
import type { ProyectoImagen } from '../../../data/proyectos';

/**
 * Figura con una captura de proyecto y su descripción.
 * @property imagen - Captura a mostrar (`src`, `alt`, `descripcion`).
 * @property captionClass - Clases del `figcaption`; por defecto el padding/tamaño de la galería plana.
 */
interface Props {
	imagen: ProyectoImagen;
	captionClass?: string;
}
const { imagen, captionClass = 'border-t border-border px-6 py-4 text-sm text-slate-400' } = Astro.props;
---
<figure class="glass-card overflow-hidden rounded-2xl">
	<img src={imagen.src} alt={imagen.alt} loading="lazy" class="w-full" />
	<figcaption class={captionClass}>
		{imagen.descripcion}
	</figcaption>
</figure>
