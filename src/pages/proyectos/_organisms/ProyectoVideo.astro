---
import { Play, Clapperboard } from '@lucide/astro';
import VideoFigura from '../_atoms/VideoFigura.astro';
import { GRUPOS_VIDEO, ProyectoSlugPage } from '../_proyectoSlugPage';
import type { ProyectoVideo } from '../../../data/proyectos';

interface Props {
	videos: ProyectoVideo[];
}
const { videos } = Astro.props;

const grupos = ProyectoSlugPage.tieneGrupos(videos)
	? ProyectoSlugPage.getGruposOrdenados(videos)
	: [];
const secciones = grupos.length > 0
	? grupos.map((grupo) => ({
			meta: GRUPOS_VIDEO[grupo] ?? { label: grupo, descripcion: '', icon: 'Play' as const },
			videos: videos.filter((video) => video.grupo === grupo),
		}))
	: [{ meta: null, videos }];
---
{
	videos.length > 0 && (
		<div class="flex flex-col gap-10">
			{secciones.map(({ meta, videos: videosDeGrupo }) => (
				<section class="flex flex-col gap-4">
					{meta && (
						<header class="flex flex-col gap-3 border-t border-secondary/30 pt-8">
							<h2 class="flex items-center gap-3">
								<span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-secondary/40 bg-secondary/10 text-secondary">
									{meta.icon === 'Play'
										? <Play class="h-5 w-5" aria-hidden="true" />
										: <Clapperboard class="h-5 w-5" aria-hidden="true" />
									}
								</span>
								<span class="font-mono text-lg font-semibold tracking-widest text-secondary uppercase sm:text-xl">
									{meta.label}
								</span>
							</h2>
							{meta.descripcion && (
								<p class="max-w-2xl text-base text-slate-300">{meta.descripcion}</p>
							)}
						</header>
					)}
					<div class="flex flex-col gap-10">
						{videosDeGrupo.map((video) => (
							<VideoFigura video={video} />
						))}
					</div>
				</section>
			))}
		</div>
	)
}
