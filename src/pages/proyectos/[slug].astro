---
import Page from '../../components/layouts/Page.astro';
import { ProyectoSlugPage } from './_proyectoSlugPage';
import ProyectoHeader from './_organisms/ProyectoHeader.astro';
import ProyectoVideo from './_organisms/ProyectoVideo.astro';
import ProyectoGaleria from './_organisms/ProyectoGaleria.astro';
import ProyectoContenidos from './_organisms/ProyectoContenidos.astro';
import ProyectosRelacionados from './_organisms/ProyectosRelacionados.astro';

export const getStaticPaths = ProyectoSlugPage.getStaticPaths;

const { proyecto } = Astro.props;

const relacionados = ProyectoSlugPage.getRelacionados(proyecto);
const contenidos = ProyectoSlugPage.getContenidos(proyecto);
const imagenes = ProyectoSlugPage.getImagenes(proyecto);
const tieneGrupos = ProyectoSlugPage.tieneGrupos(imagenes);
const gruposOrdenados = tieneGrupos ? ProyectoSlugPage.getGruposOrdenados(imagenes) : [];
---
<Page title={proyecto.nombre} description={proyecto.descripcion}>
	<div class="flex flex-col gap-8">
		<ProyectoHeader proyecto={proyecto} esContenedor={contenidos.length > 0} />

		{proyecto.videoUrl && (
			<ProyectoVideo videoUrl={proyecto.videoUrl} videoDescripcion={proyecto.videoDescripcion} />
		)}

		<ProyectoGaleria imagenes={imagenes} tieneGrupos={tieneGrupos} gruposOrdenados={gruposOrdenados} />

		<ProyectoContenidos contenidos={contenidos} />

		<ProyectosRelacionados relacionados={relacionados} />
	</div>
</Page>
