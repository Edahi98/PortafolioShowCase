---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
---
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>CV · Edahi Yaxquin Avila Garcia</title>
		<meta name="description" content="Currículum de Edahi Yaxquin Avila Garcia." />
	</head>
	<body class="min-h-screen text-slate-200 antialiased">
		<Navbar />
		<main class="mx-auto flex max-w-5xl flex-col gap-8 px-6 py-16 sm:px-8">
			<div class="flex flex-col gap-3">
				<a
					href="/"
					class="w-fit font-mono text-xs tracking-widest text-primary uppercase transition hover:text-secondary"
				>
					&larr; Volver al inicio
				</a>
				<h1 class="text-2xl font-bold sm:text-4xl">
					<span class="text-primary">Curriculum Vitae</span>
				</h1>
				<p class="text-sm text-slate-400">Edahi Yaxquin Avila Garcia</p>
			</div>

			<div class="glass-card overflow-hidden rounded-2xl">
				<iframe src="/cv/edahi-avila-cv.pdf" title="CV de Edahi Yaxquin Avila Garcia" class="h-[80vh] w-full"
				></iframe>
			</div>

			<a
				href="/cv/edahi-avila-cv.pdf"
				target="_blank"
				rel="noreferrer"
				class="w-fit rounded-full border border-border px-5 py-2 text-sm font-semibold text-slate-200 transition hover:border-primary hover:text-primary"
			>
				Abrir PDF en una pestaña nueva
			</a>
		</main>
	</body>
</html>
