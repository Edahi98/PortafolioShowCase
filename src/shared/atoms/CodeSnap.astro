---
import { Copy, Check } from '@lucide/astro';

interface Props {
	code: string;
	label?: string;
}
const { code, label } = Astro.props;
---
<div class="code-snap glass-card flex w-fit max-w-full flex-col gap-2 rounded-xl px-4 py-3">
	{label && <span class="font-mono text-xs tracking-widest text-slate-400 uppercase">{label}</span>}
	<div class="flex items-center gap-3">
		<code class="overflow-x-auto font-mono text-sm whitespace-pre text-slate-200">{code}</code>
		<button
			type="button"
			class="copiar shrink-0 rounded-lg border border-border p-2 text-slate-400 transition hover:border-primary/60 hover:text-primary"
			aria-label="Copiar al portapapeles"
		>
			<Copy class="icono-copiar h-4 w-4" aria-hidden="true" />
			<Check class="icono-listo hidden h-4 w-4 text-primary" aria-hidden="true" />
		</button>
	</div>
	<span class="aviso hidden font-mono text-xs text-primary">Copiado</span>
</div>

<script>
	document.querySelectorAll<HTMLElement>('.code-snap').forEach((snap) => {
		const boton = snap.querySelector<HTMLButtonElement>('.copiar');
		const codigo = snap.querySelector('code');
		const iconoCopiar = snap.querySelector('.icono-copiar');
		const iconoListo = snap.querySelector('.icono-listo');
		const aviso = snap.querySelector('.aviso');
		if (!boton || !codigo) return;

		let temporizador: number | undefined;

		boton.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(codigo.textContent ?? '');
			} catch {
				return;
			}

			iconoCopiar?.classList.add('hidden');
			iconoListo?.classList.remove('hidden');
			aviso?.classList.remove('hidden');

			clearTimeout(temporizador);
			temporizador = window.setTimeout(() => {
				iconoCopiar?.classList.remove('hidden');
				iconoListo?.classList.add('hidden');
				aviso?.classList.add('hidden');
			}, 2000);
		});
	});
</script>
