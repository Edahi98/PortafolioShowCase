---
interface Props {
	videoId: string;
}
const { videoId } = Astro.props;
---
<button
	data-video-id={videoId}
	aria-label="Activar audio"
	class="unmute-btn absolute bottom-4 right-4 z-10 flex h-9 w-9 items-center justify-center rounded-full border border-white/20 bg-black/40 text-white/70 backdrop-blur-sm transition hover:border-white/50 hover:text-white"
>
	<svg data-icon="muted" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
		<path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707A1 1 0 0112 5v14a1 1 0 01-1.707.707L5.586 15z"/>
		<path stroke-linecap="round" stroke-linejoin="round" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/>
	</svg>
	<svg data-icon="sound" xmlns="http://www.w3.org/2000/svg" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
		<path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072M12 6v12m-3.536-9.536A5 5 0 005.93 12a5 5 0 002.534 4.536M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707A1 1 0 0112 5v14a1 1 0 01-1.707.707L5.586 15z"/>
	</svg>
</button>

<script>
	document.querySelectorAll<HTMLButtonElement>('.unmute-btn').forEach((btn) => {
		const video = document.getElementById(btn.dataset.videoId!) as HTMLVideoElement | null;
		const iconMuted = btn.querySelector('[data-icon="muted"]');
		const iconSound = btn.querySelector('[data-icon="sound"]');

		btn.addEventListener('click', () => {
			if (!video) return;
			video.muted = !video.muted;
			iconMuted?.classList.toggle('hidden', !video.muted);
			iconSound?.classList.toggle('hidden', video.muted);
		});
	});
</script>
