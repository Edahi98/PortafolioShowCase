---
import { Crown, FileText } from '@lucide/astro';
import TrailerScene from './TrailerScene.astro';

const commits = [
	{ type: 'feat',     scope: 'tsubasa',   msg: 'add 190+ data operations',         color: '#22d3ee', delay: '0s',    top: '8%',  left: '60%' },
	{ type: 'fix',      scope: 'pipeline',  msg: 'resolve memory leak on large sets', color: '#f43f5e', delay: '1.4s',  top: '22%', left: '72%' },
	{ type: 'feat',     scope: 'reddragon', msg: 'integrate OCR extraction',          color: '#facc15', delay: '0.7s',  top: '55%', left: '58%' },
	{ type: 'chore',    scope: 'docker',    msg: 'optimize nginx config',             color: '#22d3ee', delay: '2.1s',  top: '70%', left: '75%' },
	{ type: 'perf',     scope: 'polars',    msg: 'parallel processing pipeline',      color: '#facc15', delay: '3.2s',  top: '38%', left: '65%' },
	{ type: 'refactor', scope: 'ml',        msg: 'improve prediction accuracy',       color: '#f43f5e', delay: '1.8s',  top: '85%', left: '62%' },
];
---
<section id="inicio" class="relative grid scroll-mt-24 items-center gap-10 lg:grid-cols-[1.1fr_1fr]">

	<!-- Commits flotantes decorativos (solo visibles en lg+) -->
	{commits.map((c) => (
		<span
			class="commit-float pointer-events-none absolute hidden select-none font-mono text-xs lg:block"
			style={`top:${c.top}; left:${c.left}; animation-delay:${c.delay}; color:${c.color}; opacity:0.35;`}
		>
			<span style={`color:${c.color}`}>{c.type}</span>
			<span style="color:#585b70">({c.scope}):</span>
			<span style="color:#cdd6f4"> {c.msg}</span>
		</span>
	))}

	<div class="flex flex-col gap-6">
		<p class="font-mono text-sm tracking-widest text-primary uppercase">Portafolio</p>
		<h1 class="relative text-4xl font-bold sm:text-6xl">
			<span class="text-primary">Edahi Yaxquin Avila Garcia</span>
			<img
				src="https://rustacean.net/assets/rustacean-flat-happy.svg"
				alt="Ferris"
				class="pointer-events-none absolute -right-4 -top-10 h-20 w-20 sm:-right-6 sm:-top-12 sm:h-28 sm:w-28"
				aria-hidden="true"
			/>
		</h1>
		<p class="max-w-2xl text-lg text-slate-400">
			Me apasiona enfrentar desafíos que parecen imposibles y convertirlos en soluciones reales.
			Soy un profesional autodidacta por convicción, enfocado en el desarrollo de aplicaciones
			móviles y proyectos de desarrollo web.
		</p>
		<div class="flex flex-wrap gap-4 pt-2">
			<a
				href="mailto:garciaedahi3822@gmail.com"
				class="rounded-full bg-primary px-5 py-2 text-sm font-semibold text-zinc-950 transition hover:opacity-90"
			>
				Contactar
			</a>
			<a
				href="https://github.com/Edahi98"
				target="_blank"
				rel="noreferrer"
				class="rounded-full border border-border px-5 py-2 text-sm font-semibold text-slate-200 transition hover:border-primary hover:text-primary"
			>
				github.com/Edahi98
			</a>
			<a
				href="/cv"
				class="inline-flex items-center gap-2 rounded-full bg-secondary px-5 py-2 text-sm font-semibold text-white transition hover:opacity-90"
			>
				<FileText class="h-4 w-4" aria-hidden="true" />
				Ver CV
			</a>
		</div>
		<a
			href="/#proyectos"
			class="inline-flex w-fit items-center gap-2 rounded-full border border-primary/50 bg-primary/10 px-5 py-2 text-sm font-semibold text-primary transition hover:bg-primary/20"
		>
			<Crown class="h-4 w-4" aria-hidden="true" />
			Ver proyectos destacados &rarr;
		</a>
		<div class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs">
			<a href="/#formacion" class="text-slate-400 transition hover:text-primary">
				Ver certificados &rarr;
			</a>
			<a href="/#habilidades" class="text-slate-400 transition hover:text-primary">
				Ver habilidades blandas &rarr;
			</a>
		</div>
	</div>
	<TrailerScene />
</section>

<style>
	@keyframes float {
		0%, 100% { transform: translateY(0px); }
		50%       { transform: translateY(-10px); }
	}
	.commit-float {
		animation: float 6s ease-in-out infinite;
	}
</style>
