---
import FormacionCard from './atoms/FormacionCard.astro';
import CertCard from './atoms/CertCard.astro';
import { formacion, certificaciones, cursos, reconocimientos } from '../data/formacion';
---
<section id="formacion" class="grid scroll-mt-24 gap-12 sm:grid-cols-2">

	<div class="flex flex-col gap-6">
		<h2 class="font-mono text-sm tracking-widest text-secondary uppercase">Formación</h2>
		<div class="flex flex-col gap-4">
			{formacion.map((item) => <FormacionCard {...item} />)}
		</div>
	</div>

	<div class="flex flex-col gap-6">
		<h2 class="font-mono text-sm tracking-widest text-secondary uppercase">Certificaciones</h2>
		<div class="flex flex-col gap-4">
			{certificaciones.map((item) => <CertCard {...item} />)}
		</div>
	</div>

	<div id="cursos" class="flex flex-col gap-6 scroll-mt-24 sm:col-span-2">
		<h2 class="font-mono text-sm tracking-widest text-secondary uppercase">Cursos</h2>
		<div class="flex flex-col gap-4 sm:flex-row">
			{cursos.map((item) => <CertCard {...item} />)}
		</div>
	</div>

	<div id="reconocimientos" class="flex flex-col gap-6 scroll-mt-24 sm:col-span-2">
		<h2 class="font-mono text-sm tracking-widest text-secondary uppercase">Reconocimientos</h2>
		<div class="flex flex-col gap-4 sm:flex-row">
			{reconocimientos.map((item) => <CertCard {...item} />)}
		</div>
	</div>

</section>
