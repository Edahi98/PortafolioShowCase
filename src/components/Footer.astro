---
---
<footer
	class="w-full pt-40 pb-8"
	style="background: linear-gradient(to bottom, transparent, #1e1e2e)"
>
	<div class="mx-auto max-w-5xl px-6 sm:px-8">
		<div class="flex items-center gap-2 pb-4">
			<span class="h-3 w-3 rounded-full" style="background:#f38ba8"></span>
			<span class="h-3 w-3 rounded-full" style="background:#f9e2af"></span>
			<span class="h-3 w-3 rounded-full" style="background:#a6e3a1"></span>
			<span class="ml-2 font-mono text-xs" style="color:#45475a">portafolio.ts</span>
		</div>
		<pre class="overflow-x-auto font-mono text-sm leading-relaxed" style="color:#cdd6f4"><span style="color:#cba6f7">function</span> <span style="color:#89b4fa">portafolio</span><span style="color:#cdd6f4">() {</span>
  <span style="color:#cba6f7">return</span> <span style="color:#cdd6f4">{</span>
    autor<span style="color:#cdd6f4">:      </span><span style="color:#a6e3a1">'Edahi Yaxquin Avila Garcia'</span><span style="color:#cdd6f4">,</span>
    copyright<span style="color:#cdd6f4">: </span><span style="color:#fab387">{new Date().getFullYear()}</span><span style="color:#cdd6f4">,</span>
    framework<span style="color:#cdd6f4">: </span><span style="color:#a6e3a1">'Astro'</span><span style="color:#cdd6f4">,</span>
    estilos<span style="color:#cdd6f4">:   </span><span style="color:#a6e3a1">'TailwindCSS'</span><span style="color:#cdd6f4">,</span>
    modo<span style="color:#cdd6f4">:      [</span><span style="color:#a6e3a1">'SSG'</span><span style="color:#cdd6f4">, </span><span style="color:#a6e3a1">'CSR'</span><span style="color:#cdd6f4">], </span><span style="color:#6c7086">// Static Site Generation + Client-Side Rendering</span>
  <span style="color:#cdd6f4">};</span>
<span style="color:#cdd6f4">}</span></pre>
		<div class="mt-8 flex items-center gap-4">
			<img
				src="https://rustacean.net/assets/rustacean-flat-happy.svg"
				alt="Ferris, el cangrejo de Rust"
				width="56"
				height="56"
				class="ferris h-14 w-14"
			/>
			<div class="flex flex-col gap-1">
				<span class="font-mono text-base font-semibold" style="color:#f38ba8">Rust</span>
				<span class="font-mono text-xs" style="color:#45475a">me gusta</span>
			</div>
		</div>
	</div>
</footer>

<style>
	@keyframes wiggle {
		0%, 100% { transform: rotate(-10deg); }
		50%       { transform: rotate(10deg); }
	}
	.ferris {
		animation: wiggle 1.4s ease-in-out infinite;
		transform-origin: bottom center;
	}
</style>
