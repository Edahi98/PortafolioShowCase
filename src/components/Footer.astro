---
---
<footer
	class="w-full pt-40 pb-8 border-t border-border"
	style="background: linear-gradient(to bottom, transparent 0%, color-mix(in oklab, #1e215e 85%, transparent) 30%, #1e215e 100%)"
>
	<div class="mx-auto max-w-5xl px-6 sm:px-8">
		<div class="flex items-center gap-2 pb-4">
			<span class="h-3 w-3 rounded-full" style="background:#f43f5e"></span>
			<span class="h-3 w-3 rounded-full" style="background:#facc15"></span>
			<span class="h-3 w-3 rounded-full" style="background:#22d3ee"></span>
			<span class="ml-2 font-mono text-xs" style="color:#4a5080">portafolio.rs</span>
		</div>
		<pre class="overflow-x-auto font-mono text-sm leading-relaxed" style="color:#c8cef0"><span style="color:#facc15">fn</span> <span style="color:#22d3ee">portafolio</span><span style="color:#c8cef0">() -> </span><span style="color:#22d3ee">serde_json</span><span style="color:#c8cef0">::</span><span style="color:#22d3ee">Value</span><span style="color:#c8cef0"> &#123;</span>
  <span style="color:#22d3ee">serde_json</span><span style="color:#c8cef0">::</span><span style="color:#facc15">json!</span><span style="color:#c8cef0">(&#123;</span>
    <span style="color:#a6e3a1">"autor"</span><span style="color:#c8cef0">:     </span><span style="color:#a6e3a1">"Edahi Yaxquin Avila Garcia"</span><span style="color:#c8cef0">,</span>
    <span style="color:#a6e3a1">"copyright"</span><span style="color:#c8cef0">: </span><span style="color:#facc15">{new Date().getFullYear()}</span><span style="color:#c8cef0">,</span>
    <span style="color:#a6e3a1">"framework"</span><span style="color:#c8cef0">: </span><span style="color:#a6e3a1">"Astro"</span><span style="color:#c8cef0">,</span>
    <span style="color:#a6e3a1">"estilos"</span><span style="color:#c8cef0">:   </span><span style="color:#a6e3a1">"TailwindCSS"</span><span style="color:#c8cef0">,</span>
    <span style="color:#a6e3a1">"modo"</span><span style="color:#c8cef0">:      [</span><span style="color:#a6e3a1">"SSG"</span><span style="color:#c8cef0">, </span><span style="color:#a6e3a1">"CSR"</span><span style="color:#c8cef0">]</span>
  <span style="color:#c8cef0">&#125;)</span>
<span style="color:#c8cef0">&#125;</span></pre>
		<div class="mt-8 flex items-center gap-4">
			<img
				src="https://rustacean.net/assets/rustacean-flat-happy.svg"
				alt="Ferris, el cangrejo de Rust"
				width="56"
				height="56"
				class="ferris h-14 w-14"
			/>
			<div class="flex flex-col gap-1">
				<span class="font-mono text-base font-semibold" style="color:#f43f5e">Rust</span>
				<span class="font-mono text-xs" style="color:#4a5080">me gusta</span>
			</div>
		</div>
	</div>
</footer>

<style>
	@keyframes wiggle {
		0%, 100% { transform: rotate(-10deg); }
		50%       { transform: rotate(10deg); }
	}
	.ferris {
		animation: wiggle 1.4s ease-in-out infinite;
		transform-origin: bottom center;
	}
</style>
