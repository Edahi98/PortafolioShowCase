    estilos<span style="color:#cdd6f4">:   </span><span style="color:#a6e3a1">'TailwindCSS'</span><span style="color:#cdd6f4">,</span>
    modo<span style="color:#cdd6f4">:      [</span><span style="color:#a6e3a1">'SSG'</span><span style="color:#cdd6f4">, </span><span style="color:#a6e3a1">'CSR'</span><span style="color:#cdd6f4">], </span><span style="color:#6c7086">// Static Site Generation + Client-Side Rendering</span>
  <span style="color:#cdd6f4">};</span>
<span style="color:#cdd6f4">}</span></pre>
	</div>
</footer>
