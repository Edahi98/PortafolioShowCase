---
import { Medal } from '@lucide/astro';
import GameMosaic from './atoms/GameMosaic.astro';
import UnmuteButton from './atoms/UnmuteButton.astro';

interface Props {
	src?: string;
}
const { src = '/videos/trailer.mp4' } = Astro.props;
---
<div class="relative flex flex-col gap-0">
	<div class="title-wrap relative overflow-hidden">
		<img
			src="/videos/game-title.png"
			alt="Pasar es Pasar — La última oportunidad para pasar"
			class="w-full object-contain"
		/>
	</div>
	<div class="relative h-[240px] sm:h-[320px] lg:h-[380px]">
		<GameMosaic />
		<audio id="trailer-audio" src="/videos/trailer.mp3" loop></audio>
		<UnmuteButton videoId="trailer-audio" />
	</div>
	<div class="mt-3 flex items-center gap-2">
		<img src="https://img.shields.io/badge/-C%23-239120?style=flat-square&logo=csharp&logoColor=white" alt="C#" class="h-5 opacity-70" />
		<img src="https://img.shields.io/badge/-Unity-222222?style=flat-square&logo=unity&logoColor=white" alt="Unity" class="h-5 opacity-70" />
	</div>
	<a
		href="/#reconocimientos"
		class="mt-2 flex items-center gap-3 rounded-xl border border-primary/30 bg-primary/10 px-4 py-3 transition hover:border-primary/60 hover:bg-primary/20"
	>
		<Medal class="h-6 w-6 shrink-0 text-primary" aria-hidden="true" />
		<div class="flex flex-col gap-0.5">
			<span class="font-mono text-xs font-bold text-primary">2.° Lugar — Concurso de Creación de Videojuegos</span>
			<span class="font-mono text-xs text-slate-400">Universidad Tecnológica de Tecámac · 08 de abril de 2026</span>
		</div>
	</a>
</div>

<style>
	.title-wrap {
		mask-image:
			linear-gradient(to right, transparent 0%, black 20%, black 80%, transparent 100%),
			linear-gradient(to bottom, transparent 0%, black 20%, black 70%, transparent 100%);
		mask-composite: intersect;
		-webkit-mask-image:
			linear-gradient(to right, transparent 0%, black 20%, black 80%, transparent 100%),
			linear-gradient(to bottom, transparent 0%, black 20%, black 70%, transparent 100%);
		-webkit-mask-composite: source-in;
		opacity: 0.85;
	}
</style>
