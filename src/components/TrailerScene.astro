---
import { Medal } from '@lucide/astro';
import GameMosaic from './atoms/GameMosaic.astro';
import UnmuteButton from './atoms/UnmuteButton.astro';

interface Props {
	src?: string;
}
const { src = '/videos/trailer.mp4' } = Astro.props;
---
<div class="relative flex flex-col gap-0">
	<div class="title-wrap relative overflow-hidden">
		<img
			src="/videos/game-title.png"
			alt="Pasar es Pasar — La última oportunidad para pasar"
			class="w-full object-contain"
		/>
	</div>
	<div class="relative h-[240px] sm:h-[320px] lg:h-[380px]">
		<GameMosaic />
		<audio id="trailer-audio" src="/videos/trailer.mp3" loop></audio>
		<UnmuteButton videoId="trailer-audio" />
	</div>
	<p class="mt-3 inline-flex w-full items-center justify-center gap-2 font-mono text-xs text-slate-400">
		<Medal class="h-4 w-4 text-primary shrink-0" aria-hidden="true" />
		<span class="text-primary font-semibold">2.° lugar</span> — Concurso de Creación de Videojuegos · Universidad Tecnológica de Tecámac
	</p>
</div>

<style>
	.title-wrap {
		mask-image:
			linear-gradient(to right, transparent 0%, black 20%, black 80%, transparent 100%),
			linear-gradient(to bottom, transparent 0%, black 20%, black 70%, transparent 100%);
		mask-composite: intersect;
		-webkit-mask-image:
			linear-gradient(to right, transparent 0%, black 20%, black 80%, transparent 100%),
			linear-gradient(to bottom, transparent 0%, black 20%, black 70%, transparent 100%);
		-webkit-mask-composite: source-in;
		opacity: 0.85;
	}
</style>
